# ============================================================================
# Strategy Navigator — environment. Copy to .env and fill secrets.
# All vars are prefixed SN_ and read by strategy_navigator.config.Settings.
# ============================================================================

SN_ENV=dev                       # dev | staging | prod
SN_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
SN_LOG_JSON=false                # true in staging/prod, false for local dev
SN_SERVICE_NAME=strategy-navigator

# --- HTTP API ---
SN_API_HOST=0.0.0.0
SN_API_PORT=8000
SN_API_ROOT_PATH=                # e.g. /sn when behind a path-prefixing proxy

# --- Postgres (checkpoints + job queue + app tables + search cache) ---
# One database. LangGraph checkpoints, procrastinate, and our tables coexist.
SN_DATABASE_URL=postgresql://sn:sn_dev_pw@localhost:5432/strategy_navigator
SN_DB_POOL_MIN_SIZE=2
SN_DB_POOL_MAX_SIZE=20
SN_DB_STATEMENT_TIMEOUT_MS=120000

# --- LLM gateway (LiteLLM proxy in front of DeepSeek via OpenRouter) ---
SN_LLM_BASE_URL=http://localhost:4010/v1
SN_LLM_API_KEY=sk-litellm-CHANGE-ME
SN_LLM_DEFAULT_MODEL=deepseek-v4-pro
SN_LLM_FAST_MODEL=deepseek-v4-flash-0731
SN_LLM_REQUEST_TIMEOUT_S=1800
SN_LLM_MAX_RETRIES=3
# Per-model in-process concurrency ceilings (JSON object).
# With one LiteLLM instance acting as the shared limiter these are a local guard.
SN_LLM_CONCURRENCY={"deepseek-v4-pro": 8, "deepseek-v4-flash-0731": 16}

# If you drop the LiteLLM container, point straight at OpenRouter instead:
# SN_LLM_BASE_URL=https://openrouter.ai/api/v1
# SN_LLM_API_KEY=sk-or-v1-...
# SN_LLM_DEFAULT_MODEL=openrouter/deepseek/deepseek-v4-pro

# --- Jina AI (search + reader tool) ---
SN_JINA_API_KEY=jina_CHANGE-ME
SN_JINA_SEARCH_URL=https://s.jina.ai/
SN_JINA_READER_URL=https://r.jina.ai/
SN_JINA_CACHE_TTL_S=604800       # 7 days; retries + parallel stages reuse results
SN_JINA_TIMEOUT_S=45

# --- challenges-backend callback target ---
# The LangGraph app posts stage results here, mirroring the old n8n callbacks.
SN_BACKEND_BASE_URL=http://localhost:3000
SN_BACKEND_CALLBACK_TOKEN=CHANGE-ME     # sent as Authorization: Bearer <token>
SN_BACKEND_CALLBACK_TIMEOUT_S=30
SN_BACKEND_CALLBACK_MAX_RETRIES=5

# --- Prompt export (build-time only; `strategy-navigator prompts pull`) ---
# Most stage prompts live in the n8n MongoDB (prompt_list), not the workflow
# export. Pull them into src/strategy_navigator/prompts/_mongo/ and commit.
SN_N8N_MONGO_URL=mongodb://localhost:27017
SN_N8N_MONGO_DB=n8n
# or pull via the backend API instead of Mongo:
# SN_BACKEND_URL=https://api.example.com
# SN_BACKEND_TOKEN=

# --- Queue lanes (procrastinate worker concurrency per deployment) ---
SN_LANE_SHORT_CONCURRENCY=4
SN_LANE_LONG_CONCURRENCY=6
SN_LANE_RETRY_CONCURRENCY=4
SN_RUN_MAX_ATTEMPTS=4             # attempts before a run goes to the dead-letter table

# --- Object storage for ingested project documents (optional) ---
SN_S3_BUCKET=
SN_S3_REGION=ap-south-1
SN_AWS_ACCESS_KEY_ID=
SN_AWS_SECRET_ACCESS_KEY=

# --- Tracing (optional; all no-ops when unset) ---
SN_OTEL_EXPORTER_OTLP_ENDPOINT=          # e.g. http://localhost:4318
SN_LANGFUSE_PUBLIC_KEY=
SN_LANGFUSE_SECRET_KEY=
SN_LANGFUSE_HOST=https://cloud.langfuse.com
